# 币安 API
BINANCE_API_KEY=           # 阶段 3 才需要
BINANCE_API_SECRET=        # 阶段 3 才需要
BINANCE_TESTNET=true       # 模拟盘阶段必须 true
BINANCE_PROXY_HOST=127.0.0.1
BINANCE_PROXY_PORT=7897

# 数据库
DATABASE_URL=sqlite:///data/crypto_quant.db

# 日志
LOG_LEVEL=INFO

# 采集间隔（秒）
COLLECT_INTERVAL_MARKET=300      # 5 分钟
COLLECT_INTERVAL_ONCHAIN=14400   # 4 小时
COLLECT_INTERVAL_FEAR_GREED=86400  # 1 天

# 标的范围
TOP_SYMBOLS_COUNT=50

# === 交易参数 ===
STOP_LOSS_AMOUNT=200.0           # 固定止损金额 (u)
LEVERAGE_STRATEGY_A=5            # 策略 A 杠杆
LEVERAGE_STRATEGY_B=3            # 策略 B 杠杆
INITIAL_CAPITAL=100.0            # 初始资金 (u)
ENTRY_THRESHOLD=0.65             # 入场阈值

# === 风控参数 ===
MAX_CONSECUTIVE_STOPS=3          # 连续止损暂停阈值
DAILY_LOSS_LIMIT=500.0           # 单日亏损上限 (u)
MAX_DRAWDOWN_PCT=30.0            # 总回撤暂停线 %
FEAR_GREED_PAUSE_LINE=15         # 恐贪暂停线

# === 信号参数 ===
MOMENTUM_THRESHOLD=2.5           # 涨幅异动倍数
OI_CHANGE_THRESHOLD=15.0         # OI 48h 变动阈值 %
OI_PRICE_DIVERGENCE_THRESHOLD=3.0  # OI 背离价格变动阈值 %
WHITELIST_LISTED_DAYS=180        # 新币白名单天数
WHITELIST_MAX_DAILY_MOVE=30.0    # 历史大波动阈值 %
STRATEGY_SWITCH_THRESHOLD=1.5    # 策略切换阈值

# === 信号权重（策略 A）===
WEIGHT_A_MOMENTUM=0.35
WEIGHT_A_SQUARE_HEAT=0.25
WEIGHT_A_OI_DIVERGENCE=0.20
WEIGHT_A_WHITELIST=0.10
WEIGHT_A_KRONOS=0.10

# === 信号权重（策略 B）===
WEIGHT_B_KRONOS=0.25
WEIGHT_B_MVRV=0.20
WEIGHT_B_SOPR=0.15
WEIGHT_B_ETF=0.15
WEIGHT_B_SMART_MONEY=0.15
WEIGHT_B_FEAR_GREED=0.10
