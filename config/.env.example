# 币安 API
BINANCE_API_KEY=           # 阶段 3 才需要
BINANCE_API_SECRET=        # 阶段 3 才需要
BINANCE_TESTNET=true       # 模拟盘阶段必须 true
BINANCE_PROXY_HOST=127.0.0.1
BINANCE_PROXY_PORT=7897

# 数据库
DATABASE_URL=sqlite:///data/crypto_quant.db

# 日志
LOG_LEVEL=INFO

# 采集间隔（秒）
COLLECT_INTERVAL_MARKET=300      # 5 分钟
COLLECT_INTERVAL_ONCHAIN=14400   # 4 小时
COLLECT_INTERVAL_FEAR_GREED=86400  # 1 天

# 标的范围
TOP_SYMBOLS_COUNT=50
